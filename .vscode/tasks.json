{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "serve NRF navigator",
      "type": "process",
      "command": "python",
      "args": ["-m", "http.server", "8080", "--bind", "127.0.0.1"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": ".*",
          "message": 0
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Serving HTTP on",
          "endsPattern": "Serving HTTP on"
        }
      }
    }
  ]
}
